<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="11dp"
    android:background="@drawable/bg_widget_root">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:background="@drawable/bg_widget_avatar"
            android:text="✚"
            android:textColor="#9FFFD8"
            android:textSize="16sp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bonjour Docteur"
                android:textColor="#F6FAF8"
                android:textSize="12.8sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_today_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="À synchroniser"
                android:textColor="#9FE0BE"
                android:textSize="9.2sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="Aujourd’hui"
            android:textColor="#A9C6B7"
            android:textSize="8.2sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:background="@drawable/bg_widget_date_pill" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_next_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.18"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_widget_next_default">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/widget_next_eyebrow"
                android:text="✦  PROCHAINE GARDE"
                android:textColor="#DCEBE4"
                android:textSize="7.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/widget_next_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="＋"
                android:textColor="#F5D86E"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_next_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VOS GARDES"
                android:textColor="#FFFFFF"
                android:textSize="17.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_next_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text=""
                android:textColor="#FFF0A8"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:background="@drawable/bg_widget_period_pill" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_next_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ouvrir GardeFlow pour synchroniser"
            android:textColor="#EEF6F2"
            android:textSize="8.7sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_next_countdown"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_widget_countdown_pill"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text=""
            android:textColor="#F5F8F6"
            android:textSize="9.3sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.87"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_planning_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/bg_widget_planning">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▦  PLANNING  ›"
                android:textColor="#6FE1A8"
                android:textSize="7.5sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_planning_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Voir mes gardes"
                android:textColor="#F5FAF7"
                android:textSize="8sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_planning_subdetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Calendrier"
                android:textColor="#A9D9BF"
                android:textSize="7.1sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_astreintes_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/bg_widget_astreintes">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☎  ASTREINTES  ›"
                android:textColor="#F2A66C"
                android:textSize="7.2sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_astreintes_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Voir les équipes"
                android:textColor="#FFF7F1"
                android:textSize="7.8sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_astreintes_subdetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Équipes de garde"
                android:textColor="#ECC5A1"
                android:textSize="7.1sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_practice_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/bg_widget_practice">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✦  PRACTICE  ›"
                android:textColor="#BCA7FF"
                android:textSize="7.5sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_practice_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Ce mois · QCM"
                android:textColor="#F8F5FF"
                android:textSize="7.8sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_practice_subdetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Taux de réussite"
                android:textColor="#D4BFF2"
                android:textSize="7.1sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <ProgressBar
                android:id="@+id/widget_practice_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_widget_practice_progress" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GARDEFLOW  ·  VOTRE GARDE EN UN REGARD"
            android:textColor="#79AD98"
            android:textSize="6.4sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_sync_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="À synchroniser"
            android:textColor="#84B29D"
            android:textSize="6.5sp"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
