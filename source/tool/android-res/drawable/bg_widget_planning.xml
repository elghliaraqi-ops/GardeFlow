<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#163126" android:centerColor="#11241C" android:endColor="#101713" />
            <corners android:radius="17dp" />
            <stroke android:width="1dp" android:color="#47645256" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#125CE5A7" android:endColor="#00000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
