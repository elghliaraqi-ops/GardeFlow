<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#050A08"
                android:centerColor="#091711"
                android:endColor="#0A120E" />
            <corners android:radius="25dp" />
            <stroke android:width="1dp" android:color="#263A31" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#12FFFFFF"
                android:centerColor="#0300FF99"
                android:endColor="#00000000" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#0DFFFFFF" />
        </shape>
    </item>
</layer-list>
